<?xml version="1.0" encoding="UTF-8"?>
<!--
  Browser build of Hexfront: TeaVM compiles the game's Java core (src/core) and the browser shell (src/web)
  to JavaScript. Run it through ../build.sh web, which also writes the HTML page.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.meanmutton</groupId>
    <artifactId>hexfront-web</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <properties>
        <teavm.version>0.14.1</teavm.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-classlib</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-interop</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- compile only the shared core and the browser shell (not the Android or desktop code) -->
        <sourceDirectory>../src</sourceDirectory>
        <directory>../build/web-maven</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <includes>
                        <include>core/java/**/*.java</include>
                        <include>web/java/**/*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.teavm</groupId>
                <artifactId>teavm-maven-plugin</artifactId>
                <version>${teavm.version}</version>
                <executions>
                    <!-- the offline page: no network code at all (release/Hexfront.html) -->
                    <execution>
                        <id>offline</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <phase>process-classes</phase>
                        <configuration>
                            <mainClass>com.meanmutton.mechgame.web.WebMain</mainClass>
                            <targetDirectory>${project.build.directory}/js</targetDirectory>
                            <targetFileName>hexfront.js</targetFileName>
                            <jsModuleType>NONE</jsModuleType>
                            <entryPointName>main</entryPointName>
                            <minifying>true</minifying>
                            <optimizationLevel>ADVANCED</optimizationLevel>
                        </configuration>
                    </execution>
                    <!-- the online page: the same game plus WebSocket connections to the relay (release/Hexfront-online.html) -->
                    <execution>
                        <id>online</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <phase>process-classes</phase>
                        <configuration>
                            <mainClass>com.meanmutton.mechgame.web.WebOnlineMain</mainClass>
                            <targetDirectory>${project.build.directory}/js</targetDirectory>
                            <targetFileName>hexfront-online.js</targetFileName>
                            <jsModuleType>NONE</jsModuleType>
                            <entryPointName>main</entryPointName>
                            <minifying>true</minifying>
                            <optimizationLevel>ADVANCED</optimizationLevel>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
